CREDO_BASE_URL=https://your-tenant.credo.ai/api/v1/integration
CREDO_API_KEY=your-credo-api-key
CREDO_TENANT=your-tenant-slug

# Path to write the output JSON snapshot (default: dashboard_data.json)
OUTPUT_PATH=dashboard_data.json

# Questionnaire question IDs — get these from your Credo AI questionnaire settings
# Leave blank to skip the corresponding KPI (vendor/internal, risk drivers)
Q_VENDOR_INTERNAL_QUESTION_ID=your-question-id-for-vendor-vs-internal
Q_DATA_CLASSIFICATION_QUESTION_ID=your-question-id-for-data-classification
Q_DATA_TRANSFER_QUESTION_ID=your-question-id-for-data-transfer

# Name of the custom field that stores lifecycle stage (Idea / Experiment / Production)
Q_LIFECYCLE_FIELD=Business Type

# Comma-separated answer values that count as "confidential" data classification
# CONFIDENTIAL_VALUES=Confidential,Restricted
